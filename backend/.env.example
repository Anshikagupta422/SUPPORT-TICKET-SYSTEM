# Example environment variables for the backend
# Copy this file to `.env` and edit values before running the backend.

# MongoDB connection string. If omitted, the app will start an in-memory MongoDB for development.
MONGO_URI=

# JWT secret used for signing tokens
JWT_SECRET=change_this_secret

# Comma-separated client origins allowed by CORS (frontend dev server default below)
CLIENT_URL=http://localhost:5173

# Node environment and port
NODE_ENV=development
PORT=5000
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/support_ticket_system

# Server port
PORT=5000

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CLIENT_URL=http://localhost:5173
